# =================================
# Gateway Service Configuration
# =================================
GATEWAY_PORT=8000
GATEWAY_DATABASE_URL=postgresql://svedprint:password@postgres:5432/gateway_db?sslmode=disable
GATEWAY_DATABASE_MAX_CONNS=25
GATEWAY_DATABASE_MAX_IDLE_CONNS=10
GATEWAY_DATABASE_CONN_MAX_LIFETIME=5m

# =================================
# Svedprint Service Configuration
# =================================
SVEDPRINT_PORT=8001
SVEDPRINT_DATABASE_URL=postgresql://svedprint:password@postgres:5432/svedprint_db?sslmode=disable
SVEDPRINT_DATABASE_MAX_CONNS=25
SVEDPRINT_DATABASE_MAX_IDLE_CONNS=10
SVEDPRINT_DATABASE_CONN_MAX_LIFETIME=5m

# =================================
# Svedprint Admin Service Configuration
# =================================
SVEDPRINT_ADMIN_PORT=8002
SVEDPRINT_ADMIN_DATABASE_URL=postgresql://svedprint:password@postgres:5432/admin_db?sslmode=disable
SVEDPRINT_ADMIN_DATABASE_MAX_CONNS=25
SVEDPRINT_ADMIN_DATABASE_MAX_IDLE_CONNS=10
SVEDPRINT_ADMIN_DATABASE_CONN_MAX_LIFETIME=5m

# =================================
# Svedprint Print Service Configuration
# =================================
SVEDPRINT_PRINT_PORT=8003

# =================================
# Redis Configuration
# =================================
REDIS_ADDR=redis:6379
REDIS_PASSWORD=svedprint_redis
REDIS_DB=0
REDIS_TTL=10m

# =================================
# Clerk Configuration
# =================================


# =================================
# Service URLs (Internal Network)
# =================================
SVEDPRINT_SERVICE_URL=http://svedprint:8001
SVEDPRINT_ADMIN_SERVICE_URL=http://svedprint-admin:8002
SVEDPRINT_PRINT_SERVICE_URL=http://svedprint-print:8003

# =================================
# Application Configuration
# =================================
GIN_MODE=debug
LOG_LEVEL=info

# =================================
# PostgreSQL Configuration
# =================================
POSTGRES_USER=svedprint
POSTGRES_PASSWORD=password
POSTGRES_DB=svedprint_postgres

# =================================
# Railway Production Overrides
# (These will be set by Railway automatically)
# =================================
# PORT=${PORT}
# DATABASE_URL=${DATABASE_URL}
# REDIS_URL=${REDIS_URL}
